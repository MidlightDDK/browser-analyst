{
  "name": "browser-analyst",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @browser-analyst/web --filter @browser-analyst/worker dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "e2e": "pnpm --filter @browser-analyst/web e2e",
    "test:providers": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --root worker --config vitest.providers.config.ts",
    "bench:data": "node --use-system-ca benchmark/src/data.ts",
    "bench:expected": "node benchmark/src/expected.ts",
    "bench": "node --use-system-ca --env-file-if-exists=.env benchmark/src/run.ts",
    "bench:report": "node benchmark/src/report.ts",
    "bench:judge": "node --use-system-ca --env-file-if-exists=.env benchmark/src/judge.ts",
    "redteam": "node --use-system-ca --env-file-if-exists=.env benchmark/redteam/run.ts",
    "replay:record": "node --use-system-ca --env-file-if-exists=.env benchmark/src/replay-record.ts",
    "build": "pnpm --filter @browser-analyst/web build && pnpm --filter @browser-analyst/worker build",
    "deploy": "pnpm build && pnpm --filter @browser-analyst/worker run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
